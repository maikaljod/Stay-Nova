# Copy this file to .env and fill in real values. Never commit the real .env file.

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string

# MySQL (pymysql) — matches MySQL Workbench local credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=staynova

# Session cookie security — set to true once served over HTTPS
SESSION_COOKIE_SECURE=false

# Seed admin account created by scripts/init_db.py
ADMIN_EMAIL=admin@staynova.com
ADMIN_PASSWORD=Admin@12345

# Outgoing email (verification / password reset links).
# Leave MAIL_SERVER blank in development — emails are written to
# instance/outbox/ instead of being sent.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@staynova.com

# Base URL used to build absolute links in emails
APP_BASE_URL=http://127.0.0.1:5000

# Token lifetimes (seconds) and 2FA app name
EMAIL_VERIFICATION_MAX_AGE=86400
PASSWORD_RESET_MAX_AGE=3600
TOTP_ISSUER_NAME=StayNova
