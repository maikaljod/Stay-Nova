# Copy this file to .env and fill in real values. Never commit the real .env file.

# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-to-a-long-random-string

# MySQL (pymysql) — matches MySQL Workbench local credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=staynova

# Session cookie security — set to true once served over HTTPS
SESSION_COOKIE_SECURE=false

# Seed admin account created by scripts/init_db.py
ADMIN_EMAIL=admin@staynova.com
ADMIN_PASSWORD=Admin@12345
